# --- Brain Tumor Analysis Platform: Environment Template ---------------------
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# --- Application --------------------------------------------------------------
APP_NAME="Brain Tumor Analysis Platform"
DEBUG=false
ENVIRONMENT=production

# --- Security (REQUIRED: generate with: openssl rand -hex 32) ----------------
SECRET_KEY=your-super-secret-key-change-in-production

# --- Database ------------------------------------------------------------------
# Option 1: Supabase / PostgreSQL:
#   Format: postgresql+asyncpg://user:password@host:5432/dbname
# Option 2: Local SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./brain_tumor.db

# --- CORS (comma-separated list of allowed frontend origins) ------------------
# Add your production frontend domain here (e.g. https://yourdomain.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI: Google Gemini (Get key at: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI: HuggingFace Inference API (Optional) ---------------------------------
# Get key at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# --- File Storage: Cloudinary (Optional fallback) -----------------------------
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
